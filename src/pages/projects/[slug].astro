---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, tags, repo, draft } = project.data;
---

<Base title={title} description={summary}>
  <a class="back" href="/projects/">← All projects</a>

  <header class="article-header">
    <h1>{title}{draft && ' (draft)'}</h1>
    <p class="lede">{summary}</p>
    <div class="article-meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
      </time>
      {repo && <a href={repo} rel="noopener">View on GitHub →</a>}
    </div>
    {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
  </header>

  <article class="prose">
    <Content />
  </article>
</Base>
